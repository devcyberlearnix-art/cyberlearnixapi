{
  "settings": {
    "analysis": {
      "analyzer": {
        "simple_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "lowercase"
          ]
        }
      }
    },
    "index": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    }
  },
  "mappings": {
    "properties": {
      "gtin": {
        "type": "keyword"
      },
      "sku": {
        "type": "text"
      },
      "productName": {
        "type": "text"
      },
      "brandName": {
        "type": "text"
      },
      "category": {
        "type": "text"
      },
      "description": {
        "type": "text"
      },
      "price": {
        "type": "double"
      },
      "originalPrice": {
        "type": "double"
      },
      "stock": {
        "type": "integer"
      },
      "isActive": {
        "type": "boolean"
      },
      "isCustom": {
        "type": "boolean"
      },
      "createdByStoreId": {
        "type": "long"
      },
      "tags": {
        "type": "keyword"
      },
      "imageUrls": {
        "type": "keyword"
      },
      "weight": {
        "type": "double"
      },
      "weightUnit": {
        "type": "keyword"
      },
      "rating": {
        "type": "double"
      },
      "reviewCount": {
        "type": "integer"
      },
      "salesCount": {
        "type": "long"
      },
      "createdAt": {
        "type": "date"
      },
      "updatedAt": {
        "type": "date"
      }
    }
  }
}
