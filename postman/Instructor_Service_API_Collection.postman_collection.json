						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Advanced Java\",\n    \"description\": \"Deep dive into Java\",\n    \"price\": 1499.99,\n    \"category\": \"Programming\",\n    \"level\": \"INTERMEDIATE\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/instructors/:id/courses",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "instructors", ":id", "courses"],
							"variable": [
								{
									"key": "id",
									"value": "{{instructorId}}"
								}
							]
						},
						"description": "Create a new course for instructor. Requires authentication."
					},
