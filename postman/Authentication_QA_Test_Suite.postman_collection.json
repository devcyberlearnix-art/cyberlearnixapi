    {
      "name": "5. Security Tests",
      "item": [
        {
          "name": "5.1 SQL Injection Test",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401 or 400\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 400]);",
                  "});",
                  "",
                  "pm.test(\"SQL injection blocked\", function () {",
                  "    pm.expect(pm.response.code).to.not.eql(500);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"' OR '1'='1\",\n  \"password\": \"test\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
