	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Admin Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Login successful\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('authentication');",
									"    pm.expect(jsonData.authentication).to.have.property('accessToken');",
									"});",
									"",
									"// Save token to collection variable",
									"var jsonData = pm.response.json();",
									"if (jsonData.authentication) {",
									"    pm.collectionVariables.set('accessToken', jsonData.authentication.accessToken);",
									"    console.log('Admin token saved successfully');",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"mainadmin@cyberlearnix.com\",\n    \"password\": \"MainAdmin@123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/admins/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "admins", "login"]
						},
						"description": "Login as Main Admin. Returns JWT token for authentication."
					},
					"response": []
				},
