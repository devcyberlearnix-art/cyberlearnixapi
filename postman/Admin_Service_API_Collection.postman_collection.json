	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8087",
			"type": "string"
		},
		{
			"key": "accessToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "refreshToken",
			"value": "",
			"type": "string"
		}
