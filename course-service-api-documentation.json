                "isCorrect": "boolean",
                "orderIndex": "integer"
              }
            }
          },
          "path_params": {
            "quizId": {
              "type": "Long",
              "required": true,
              "description": "Quiz ID"
            }
          },
          "example_request": {
            "questionText": "What is the correct syntax to print 'Hello World' in Java?",
            "questionType": "MULTIPLE_CHOICE",
            "marks": 5,
            "orderIndex": 1,
            "explanation": "System.out.println() is the correct method",
            "options": [
              {
                "optionText": "print('Hello World')",
                "isCorrect": false,
                "orderIndex": 1
              },
              {
                "optionText": "System.out.println('Hello World')",
                "isCorrect": true,
                "orderIndex": 2
              },
              {
                "optionText": "console.log('Hello World')",
                "isCorrect": false,
                "orderIndex": 3
              },
              {
                "optionText": "echo 'Hello World'",
                "isCorrect": false,
                "orderIndex": 4
              }
            ]
          }
        },
