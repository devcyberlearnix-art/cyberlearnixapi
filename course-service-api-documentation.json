{
  "service": "course-service",
  "version": "v1",
  "base_path": "/api/v1",
  "description": "Course Service API Documentation",
  "apis": [
    {
      "category": "Course Management",
      "endpoints": [
        {
          "name": "Create Course",
          "method": "POST",
          "path": "/courses",
          "auth_required": true,
          "roles": ["INSTRUCTOR", "MAIN_ADMIN", "SUB_ADMIN"],
          "request_body": {
            "title": {
              "type": "string",
              "required": true,
              "validation": "min 3, max 100 characters"
            },
            "subtitle": {
              "type": "string",
              "required": false,
              "validation": "max 200 characters"
            },
            "description": {
              "type": "string",
              "required": true,
              "validation": "min 10, max 2000 characters"
            },
            "category": {
              "type": "string",
              "required": true,
              "validation": "max 50 characters"
            },
            "level": {
              "type": "string",
              "required": false,
              "validation": "max 50 characters"
            },
            "language": {
              "type": "string",
              "required": false,
              "validation": "max 50 characters"
            },
            "price": {
              "type": "number",
              "required": true,
              "validation": "min 0.0"
            },
            "thumbnail": {
              "type": "string",
              "required": false,
              "validation": "valid URL"
            },
            "instructorId": {
              "type": "UUID",
              "required": true
            },
            "status": {
              "type": "string",
              "required": false,
              "validation": "must be DRAFT, PUBLISHED, or ARCHIVED"
            },
            "premium": {
              "type": "boolean",
              "required": false
            }
          },
          "example_request": {
            "title": "Java Programming Masterclass",
            "subtitle": "Learn Java from scratch",
            "description": "Comprehensive Java course covering basics to advanced concepts",
            "category": "Programming",
            "level": "Beginner",
            "language": "English",
            "price": 99.99,
            "thumbnail": "https://example.com/thumbnail.jpg",
            "instructorId": "123e4567-e89b-12d3-a456-426614174000",
            "status": "DRAFT",
            "premium": true
          }
        },
        {
          "name": "Update Course (Full)",
          "method": "PUT",
          "path": "/courses/{id}",
          "auth_required": true,
          "roles": ["INSTRUCTOR", "MAIN_ADMIN", "SUB_ADMIN"],
          "request_body": "Full Course entity object",
          "path_params": {
            "id": {
              "type": "Long",
              "required": true,
              "description": "Course ID"
            }
          }
        },
        {
          "name": "Update Course (Partial)",
          "method": "PATCH",
          "path": "/courses/{id}",
          "auth_required": true,
          "roles": ["INSTRUCTOR", "MAIN_ADMIN", "SUB_ADMIN"],
          "request_body": "Partial Course entity object",
          "path_params": {
            "id": {
              "type": "Long",
              "required": true,
              "description": "Course ID"
            }
          }
        },
        {
          "name": "Update Course Status",
          "method": "PATCH",
          "path": "/courses/{id}/status",
          "auth_required": true,
          "roles": ["INSTRUCTOR", "MAIN_ADMIN", "SUB_ADMIN"],
          "request_body": {
            "status": {
              "type": "string",
              "required": true
            }
          },
          "path_params": {
            "id": {
              "type": "Long",
              "required": true,
              "description": "Course ID"
            }
          },
          "example_request": {
            "status": "PUBLISHED"
          }
        },
        {
          "name": "Delete Course",
          "method": "DELETE",
          "path": "/courses/{id}",
          "auth_required": true,
          "roles": ["INSTRUCTOR", "MAIN_ADMIN", "SUB_ADMIN"],
          "request_body": null,
          "path_params": {
            "id": {
              "type": "Long",
              "required": true,
              "description": "Course ID"
            }
          }
        }
      ]
    },
